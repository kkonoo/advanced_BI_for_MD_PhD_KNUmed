library(tidyverse)
library(readxl)
# ===== 디렉토리 설정 =====
indir  <- "rawdata/"
outdir <- "analysis/"
resdir <- "results/"
# ===== 파라미터 설정 =====
DATA_FILE <- paste0(indir, "clinical_data.xlsx")
TIME_VAR  <- "OS"
EVENT_VAR <- "Death"
GROUP_VAR <- "Multiplicity"
AGE_CUT   <- 65
# 데이터 로드
df <- read_excel(DATA_FILE)
# 데이터 확인
dim(df)     # 76행 x 33열
str(df)     # 변수 타입 한눈에
names(df)   # 변수(데이터) 이름
head(df)    # 앞만 출력
# 환자 수 vs 병변 수
n_distinct(df$Key_pt)       # 환자 수
nrow(df)                    # 병변 수 (= 행 수)
# 환자당 병변 수 확인
df %>% count(Key_pt, sort = TRUE)
# 환자 단위 분석용: 환자당 1행만
df_pt <- df %>% filter(IN_sur == 1)
nrow(df_pt)
# 특정 조건 필터
df_pt %>% filter(Age_Tx >= 65, Sex == "M")
# 여러 조건 조합
df_pt %>% filter(Primary == "Colon" | Primary == "Rectum")
df_pt %>% filter(Primary %in% c("Colon", "Rectum"))  # 같은 결과, 더 깔끔
# 필요한 열만
df_pt %>% select(Key_pt, Sex, Age_Tx, Primary, Death, OS)
# 특정 패턴 열 선택
df_pt %>% select(starts_with("PTV"))
df_pt %>% select(Key_pt, Sex:Age_Tx, Death:LFFS)
df_pt <- df_pt %>%
mutate(
# 연령군
Age_group = ifelse(Age_Tx >= 65, "≥65", "<65"),
# factor 변환 (Table 1에서 범주형으로 인식시키기 위해)
Sex = factor(Sex, levels = c("M", "F"), labels = c("Male", "Female")),
Death = factor(Death, levels = c(0, 1), labels = c("Alive", "Dead")),
# 연속형 변수 단위 변환
size_cm = size_mm / 10,
# BED10 카테고리
BED_group = case_when(
PTVmean_BED10 >= 100 ~ "≥100 Gy",
PTVmean_BED10 >= 80  ~ "80-99 Gy",
TRUE                  ~ "<80 Gy"
)
)
# Primary별 환자 수, 중앙 나이
df_pt %>%
group_by(Primary) %>%
summarise(
n = n(),
median_age = median(Age_Tx),
death_rate = mean(Death == "Dead")
) %>%
arrange(desc(n))
# 중간 산물: rds로 저장 (factor, 타입 보존)
saveRDS(df_pt,     paste0(outdir, "1_df_pt.rds"))
